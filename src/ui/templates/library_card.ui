<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library Card Template

  Layout:
    [reorder col]  [main content]
       ▲           Name               [Rescan] [Edit]
       🔒           /path/to/music
       ▼           stats...
                   [edit revealer - integration toggles, remove, etc.]
                   [progress revealer - phase bars during indexing]
-->
<interface>
  <object class="GtkBox" id="library_card">
    <property name="orientation">horizontal</property>
    <property name="spacing">0</property>
    <style>
      <class name="library-card"/>
    </style>

    <!-- Left column: reorder controls (up / lock / down) -->
    <child>
      <object class="GtkBox" id="reorder_box">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <property name="valign">center</property>
        <property name="margin-end">12</property>
        <style>
          <class name="library-reorder"/>
        </style>

        <child>
          <object class="GtkButton" id="move_up_btn">
            <property name="icon-name">go-up-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text">Move up</property>
            <style>
              <class name="library-reorder-btn"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkButton" id="lock_btn">
            <property name="icon-name">changes-prevent-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text">Locked (double-click to unlock)</property>
            <style>
              <class name="library-lock-btn"/>
              <class name="library-locked"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkButton" id="move_down_btn">
            <property name="icon-name">go-down-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text">Move down</property>
            <style>
              <class name="library-reorder-btn"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <!-- Main content column -->
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <property name="hexpand">true</property>

        <!-- Header: name/path (left) + action buttons (right) -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-bottom">8</property>
            <style>
              <class name="library-card-header"/>
            </style>

            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <property name="hexpand">true</property>

                <child>
                  <object class="GtkLabel" id="card_name">
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <style>
                      <class name="library-card-name"/>
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="card_path">
                    <property name="xalign">0</property>
                    <property name="ellipsize">middle</property>
                    <style>
                      <class name="library-card-path"/>
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="card_data_path">
                    <property name="xalign">0</property>
                    <property name="ellipsize">middle</property>
                    <property name="visible">false</property>
                    <style>
                      <class name="library-card-path"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">4</property>
                <property name="valign">center</property>

                <child>
                  <object class="GtkButton" id="card_rescan">
                    <property name="icon-name">view-refresh-symbolic</property>
                    <property name="tooltip-text">Rescan library</property>
                    <style>
                      <class name="library-card-action"/>
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="card_edit_btn">
                    <property name="icon-name">emblem-system-symbolic</property>
                    <property name="tooltip-text">Edit library settings</property>
                    <style>
                      <class name="library-card-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Stats section -->
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <style>
              <class name="library-card-stats"/>
            </style>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>
                <child>
                  <object class="GtkLabel" id="stat_tracks">
                    <property name="label">0 tracks</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="stat_albums">
                    <property name="label">0 albums</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="stat_artists">
                    <property name="label">0 artists</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="stat_last_scanned">
                    <property name="label">Never scanned</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                    <style>
                      <class name="library-card-meta"/>
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="stat_errors_btn">
                    <property name="label">0 errors</property>
                    <property name="visible">false</property>
                    <style>
                      <class name="error-button"/>
                      <class name="library-card-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Edit section (revealed when Edit clicked) -->
        <child>
          <object class="GtkRevealer" id="edit_revealer">
            <property name="reveal-child">false</property>
            <property name="transition-type">slide-down</property>
            <property name="transition-duration">200</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-top">12</property>
                <style>
                  <class name="library-edit-section"/>
                </style>

                <!-- Library Name -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Library Name</property>
                        <property name="xalign">0</property>
                        <style><class name="library-edit-label"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="edit_name_entry">
                        <property name="placeholder-text">Display name (empty = folder name)</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Metadata Enhancement heading -->
                <child>
                  <object class="GtkSeparator"/>
                </child>

                <child>
                  <object class="GtkLabel">
                    <property name="label">Metadata Enhancement</property>
                    <property name="xalign">0</property>
                    <style><class name="library-edit-heading"/></style>
                  </object>
                </child>

                <!-- MusicBrainz toggle -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">MusicBrainz</property>
                        <property name="hexpand">true</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="mb_toggle_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">0</property>
                        <style><class name="linked"/></style>
                        <child>
                          <object class="GtkToggleButton" id="mb_default_btn">
                            <property name="label">Default</property>
                            <property name="active">true</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="mb_on_btn">
                            <property name="label">On</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="mb_off_btn">
                            <property name="label">Off</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- AcoustID toggle -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">AcoustID</property>
                        <property name="hexpand">true</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="acoustid_toggle_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">0</property>
                        <style><class name="linked"/></style>
                        <child>
                          <object class="GtkToggleButton" id="acoustid_default_btn">
                            <property name="label">Default</property>
                            <property name="active">true</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="acoustid_on_btn">
                            <property name="label">On</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="acoustid_off_btn">
                            <property name="label">Off</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- fanart.tv toggle -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">fanart.tv</property>
                        <property name="hexpand">true</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="fanart_toggle_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">0</property>
                        <style><class name="linked"/></style>
                        <child>
                          <object class="GtkToggleButton" id="fanart_default_btn">
                            <property name="label">Default</property>
                            <property name="active">true</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="fanart_on_btn">
                            <property name="label">On</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="fanart_off_btn">
                            <property name="label">Off</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Wikipedia toggle -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Wikipedia</property>
                        <property name="hexpand">true</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="wikipedia_toggle_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">0</property>
                        <style><class name="linked"/></style>
                        <child>
                          <object class="GtkToggleButton" id="wikipedia_default_btn">
                            <property name="label">Default</property>
                            <property name="active">true</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="wikipedia_on_btn">
                            <property name="label">On</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="wikipedia_off_btn">
                            <property name="label">Off</property>
                            <style><class name="library-toggle"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Action row: Remove + Done -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-top">8</property>
                    <child>
                      <object class="GtkButton" id="card_remove">
                        <property name="label">Remove Library</property>
                        <style>
                          <class name="destructive-action"/>
                          <class name="library-card-action"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="card_edit_done">
                        <property name="label">Done</property>
                        <property name="hexpand">true</property>
                        <property name="halign">end</property>
                        <style>
                          <class name="suggested-action"/>
                          <class name="library-card-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Progress section (revealed during scan) -->
        <child>
          <object class="GtkRevealer" id="progress_revealer">
            <property name="reveal-child">false</property>
            <property name="transition-type">slide-down</property>
            <property name="transition-duration">300</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <style>
                  <class name="library-card-progress"/>
                </style>

                <!-- Phase 0-6: generated identically -->
                <child>
                  <object class="GtkBox" id="phase_0_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_0_title"><property name="label">Scanning directories</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_0_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_0_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_0_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_1_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_1_title"><property name="label">Extracting metadata</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_1_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_1_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_1_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_2_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_2_title"><property name="label">Processing artwork</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_2_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_2_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_2_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_3_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_3_title"><property name="label">Acoustid fingerprinting</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_3_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_3_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_3_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_4_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_4_title"><property name="label">MusicBrainz resolution</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_4_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_4_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_4_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_5_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_5_title"><property name="label">Fetching artist images</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_5_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_5_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_5_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="phase_6_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="progress-phase"/><class name="progress-phase-dim"/></style>
                    <child><object class="GtkLabel" id="phase_6_title"><property name="label">Fetching artist bios</property><property name="xalign">0</property><style><class name="progress-phase-title"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">horizontal</property><child><object class="GtkLabel" id="phase_6_status"><property name="label">Waiting</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="progress-phase-label"/></style></object></child><child><object class="GtkLabel" id="phase_6_rate"><property name="xalign">1</property><property name="visible">false</property><style><class name="progress-phase-rate"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar" id="phase_6_bar"><style><class name="progress-phase-bar"/></style></object></child>
                  </object>
                </child>

              </object>
            </child>
          </object>
        </child>

      </object>
    </child>

  </object>
</interface>
