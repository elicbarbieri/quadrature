<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library Detail View Container Template

  Container for artist/album detail views.
  C code:
  - Loads and populates detail_header
  - Sets section label text
  - Creates and adds ListView to scroll window
-->
<interface>
  <object class="GtkBox" id="container">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">16</property>
    <property name="margin-end">16</property>
    <property name="margin-top">16</property>

    <!-- Header placeholder (detail_header inserted by C code) -->

    <!-- Section label -->
    <child>
      <object class="GtkLabel" id="section_label">
        <property name="label">Items</property>
        <property name="xalign">0</property>
        <property name="margin-top">16</property>
        <style>
          <class name="library-section-header"/>
        </style>
      </object>
    </child>

    <!-- Scroll window -->
    <child>
      <object class="GtkScrolledWindow" id="scroll">
        <property name="vexpand">true</property>
      </object>
    </child>
  </object>
</interface>
