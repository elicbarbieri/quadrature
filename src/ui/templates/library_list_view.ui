<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library List View Template

  Container for Artists and Albums main views.
  Title, subtitle, and scroll window. Filter bar is inserted programmatically.
-->
<interface>
  <object class="GtkBox" id="container">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">16</property>
    <property name="margin-top">16</property>

    <!-- Title -->
    <child>
      <object class="GtkLabel" id="title">
        <property name="label">Title</property>
        <property name="xalign">0</property>
        <property name="margin-end">16</property>
        <style>
          <class name="library-title"/>
        </style>
      </object>
    </child>

    <!-- Subtitle (item count) -->
    <child>
      <object class="GtkLabel" id="subtitle">
        <property name="label">Loading...</property>
        <property name="xalign">0</property>
        <property name="margin-end">16</property>
        <style>
          <class name="library-subtitle"/>
        </style>
      </object>
    </child>

    <!-- Filter bar inserted programmatically here by C code -->

    <!-- Scroll window (GtkListView implements GtkScrollable directly) -->
    <child>
      <object class="GtkScrolledWindow" id="scroll">
        <property name="vexpand">true</property>
        <property name="overlay-scrolling">false</property>
      </object>
    </child>
  </object>
</interface>
