<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="settings_view">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <style>
      <class name="view-container"/>
    </style>

    <!-- Title -->
    <child>
      <object class="GtkLabel">
        <property name="label">Settings</property>
        <property name="xalign">0</property>
        <style>
          <class name="library-title"/>
        </style>
      </object>
    </child>

    <!-- Scrollable content -->
    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox" id="settings_content">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="margin-top">16</property>

            <!-- Audio Channels Section Header -->
            <child>
              <object class="GtkLabel">
                <property name="label">AUDIO CHANNELS</property>
                <property name="xalign">0</property>
                <style>
                  <class name="library-section-header"/>
                </style>
              </object>
            </child>

            <!-- Channel frames container (populated programmatically) -->
            <child>
              <object class="GtkBox" id="channel_frames_box">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
              </object>
            </child>

            <!-- Display Section Header -->
            <child>
              <object class="GtkLabel">
                <property name="label">DISPLAY</property>
                <property name="xalign">0</property>
                <property name="margin-top">16</property>
                <style>
                  <class name="library-section-header"/>
                </style>
              </object>
            </child>

            <!-- Spectrum checkbox -->
            <child>
              <object class="GtkCheckButton" id="spectrum_checkbox">
                <property name="label">Show spectrum analyzer</property>
                <property name="active">true</property>
              </object>
            </child>

            <!-- Library Section Header -->
            <child>
              <object class="GtkLabel">
                <property name="label">LIBRARY</property>
                <property name="xalign">0</property>
                <property name="margin-top">16</property>
                <style>
                  <class name="library-section-header"/>
                </style>
              </object>
            </child>

            <!-- Thumbnail size dropdown -->
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Thumbnail size</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="art_size_dropdown">
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>48px</item>
                          <item>64px</item>
                          <item>96px</item>
                          <item>128px</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <!-- MusicBrainz Section Header -->
            <child>
              <object class="GtkLabel">
                <property name="label">MUSICBRAINZ</property>
                <property name="xalign">0</property>
                <property name="margin-top">16</property>
                <style>
                  <class name="library-section-header"/>
                </style>
              </object>
            </child>

            <!-- Fingerprint tracks toggle -->
            <child>
              <object class="GtkCheckButton" id="fingerprint_checkbox">
                <property name="label">Generate AcoustID fingerprints during indexing</property>
                <property name="active">false</property>
              </object>
            </child>

            <!-- MusicBrainz resolve toggle -->
            <child>
              <object class="GtkCheckButton" id="mb_resolve_checkbox">
                <property name="label">Resolve metadata from MusicBrainz after indexing</property>
                <property name="active">false</property>
              </object>
            </child>

            <!-- PostgreSQL connection string -->
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">PostgreSQL connection</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="pg_conninfo_entry">
                    <property name="hexpand">true</property>
                    <property name="placeholder-text">host=localhost dbname=musicbrainz_db user=musicbrainz</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
