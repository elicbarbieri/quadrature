<?xml version="1.0" encoding="UTF-8"?>
<!--
  Artist Menu Button Template
  
  Menu button with ellipsized label and optional popover for artist navigation.
  Popover list is populated dynamically when multiple artists exist.
-->
<interface>
  <object class="GtkMenuButton" id="artist_menu_btn">
    <property name="has-frame">false</property>
    <property name="always-show-arrow">false</property>
    <style>
      <class name="artist-btn"/>
    </style>
    
    <!-- Button label -->
    <child>
      <object class="GtkLabel" id="artist_label">
        <property name="ellipsize">end</property>
        <property name="max-width-chars">20</property>
      </object>
    </child>
  </object>
</interface>
