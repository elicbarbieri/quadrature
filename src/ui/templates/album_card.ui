<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quadrature Album Detail Card

  Unified album display for both album detail view (single card) and artist detail view (multiple cards).
  Uses same structure and CSS classes as album_detail_page.ui.
-->
<interface>
  <object class="GtkBox" id="album_card">
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <style>
      <class name="album-card"/>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CARD HEADER: Art + Metadata
         ═══════════════════════════════════════════════════════════════════ -->
    <child>
      <object class="GtkBox" id="card_header">
        <property name="orientation">horizontal</property>
        <property name="spacing">28</property>
        <property name="margin-bottom">16</property>

        <!-- Album Art Container -->
        <child>
          <object class="GtkBox" id="card_art_container">
            <property name="orientation">vertical</property>
            <property name="overflow">hidden</property>
            <style>
              <class name="detail-album-art"/>
            </style>
            <child>
              <object class="GtkPicture" id="card_art">
                <property name="content-fit">contain</property>
                <property name="can-shrink">true</property>
                <property name="width-request">300</property>
                <property name="height-request">300</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Info Box -->
        <child>
          <object class="GtkBox" id="card_info">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="valign">center</property>
            <property name="hexpand">true</property>

            <!-- Album Title -->
            <child>
              <object class="GtkLabel" id="card_title">
                <property name="label">Album Title</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="hexpand">true</property>
                <style>
                  <class name="detail-title"/>
                </style>
              </object>
            </child>

            <!-- Artist + Year Row -->
            <child>
              <object class="GtkBox" id="card_artist_year_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>

                <!-- Artist Link Button -->
                <child>
                  <object class="GtkButton" id="card_artist_link">
                    <property name="label">Artist Name</property>
                    <property name="halign">start</property>
                    <style>
                      <class name="flat"/>
                      <class name="album-detail-artist"/>
                    </style>
                  </object>
                </child>

                <!-- Year Label -->
                <child>
                  <object class="GtkLabel" id="card_year">
                    <property name="label"></property>
                    <style>
                      <class name="detail-meta"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <!-- Label (record label) -->
            <child>
              <object class="GtkLabel" id="card_label">
                <property name="label"></property>
                <property name="xalign">0</property>
                <property name="visible">false</property>
                <style>
                  <class name="detail-meta"/>
                </style>
              </object>
            </child>

            <!-- Stats (track count, duration) -->
            <child>
              <object class="GtkLabel" id="card_stats">
                <property name="label">12 tracks - 45:32</property>
                <property name="xalign">0</property>
                <style>
                  <class name="detail-meta"/>
                </style>
              </object>
            </child>

            <!-- Library Toggle Buttons (hidden for single-library albums) -->
            <child>
              <object class="GtkBox" id="card_library_toggles">
                <property name="orientation">horizontal</property>
                <property name="spacing">4</property>
                <property name="visible">false</property>
              </object>
            </child>

            <!-- Genre Pills -->
            <child>
              <object class="GtkBox" id="card_genres">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <property name="visible">false</property>
              </object>
            </child>

            <!-- Album Path Button -->
            <child>
              <object class="GtkButton" id="card_path_btn">
                <property name="halign">start</property>
                <property name="visible">false</property>
                <style>
                  <class name="flat"/>
                  <class name="album-path-btn"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- ═══════════════════════════════════════════════════════════════════
         TRACK LIST: Container for track rows (populated by C code)
         ═══════════════════════════════════════════════════════════════════ -->
    <child>
      <object class="GtkListBox" id="track_list">
        <property name="selection-mode">single</property>
        <property name="activate-on-single-click">false</property>
        <property name="overflow">visible</property>
        <style>
          <class name="album-tracks-list"/>
          <class name="library-list"/>
        </style>
        <!-- Track rows added here by C code -->
      </object>
    </child>

  </object>
</interface>
