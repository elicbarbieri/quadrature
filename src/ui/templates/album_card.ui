<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quadrature Album Detail Card

  Unified album display for both album detail view (single card) and artist detail view (multiple cards).
  Uses same structure and CSS classes as album_detail_page.ui.
-->
<interface>
  <object class="GtkBox" id="album_card">
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <style>
      <class name="album-card"/>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CARD HEADER: Art + Metadata
         ═══════════════════════════════════════════════════════════════════ -->
    <child>
      <object class="GtkBox" id="card_header">
        <property name="orientation">horizontal</property>
        <property name="spacing">28</property>
        <property name="margin-bottom">16</property>

        <!-- Album Art Container -->
        <child>
          <object class="GtkBox" id="card_art_container">
            <property name="orientation">vertical</property>
            <property name="overflow">hidden</property>
            <style>
              <class name="detail-album-art"/>
            </style>
            <child>
              <object class="GtkImage" id="card_art">
                <property name="icon-name">media-optical-symbolic</property>
                <property name="pixel-size">250</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Info Box -->
        <child>
          <object class="GtkBox" id="card_info">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="valign">center</property>
            <property name="hexpand">true</property>

            <!-- Album Title -->
            <child>
              <object class="GtkLabel" id="card_title">
                <property name="label">Album Title</property>
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="selectable">true</property>
                <property name="hexpand">true</property>
                <style>
                  <class name="detail-title"/>
                </style>
              </object>
            </child>

            <!-- Artist + Year Row -->
            <child>
              <object class="GtkBox" id="card_artist_year_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>

                <!-- Artist Link Button -->
                <child>
                  <object class="GtkButton" id="card_artist_link">
                    <property name="label">Artist Name</property>
                    <property name="halign">start</property>
                    <style>
                      <class name="flat"/>
                      <class name="album-detail-artist"/>
                    </style>
                  </object>
                </child>

                <!-- Year Label -->
                <child>
                  <object class="GtkLabel" id="card_year">
                    <property name="label"></property>
                    <property name="selectable">true</property>
                    <style>
                      <class name="detail-meta"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <!-- Stats (track count, duration) -->
            <child>
              <object class="GtkLabel" id="card_stats">
                <property name="label">12 tracks - 45:32</property>
                <property name="xalign">0</property>
                <property name="selectable">true</property>
                <style>
                  <class name="detail-meta"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- ═══════════════════════════════════════════════════════════════════
         TRACK LIST: Container for track rows (populated by C code)
         ═══════════════════════════════════════════════════════════════════ -->
    <child>
      <object class="GtkListBox" id="track_list">
        <property name="selection-mode">single</property>
        <property name="activate-on-single-click">false</property>
        <style>
          <class name="album-tracks-list"/>
        </style>
        <!-- Track rows added here by C code -->
      </object>
    </child>

  </object>
</interface>
