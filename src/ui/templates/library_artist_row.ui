<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library Artist Row Template

  ProportionalBox layout: [art (natural)] [left (60%)] [right (40%)] [meta (empty)]

  art:   Artist thumbnail (48px, circular)
  left:  Artist name + album/track count subtitle
  right: Album art strip (up to 6 recent albums)
-->
<interface>
  <object class="ProportionalBox" id="row">
    <property name="spacing">12</property>
    <property name="left-ratio">0.6</property>
    <property name="hexpand">true</property>
    <style>
      <class name="library-artist-row"/>
    </style>

    <!-- art slot: artist thumbnail -->
    <child type="art">
      <object class="GtkImage" id="artist_art">
        <property name="pixel-size">48</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <property name="icon-name">avatar-default-symbolic</property>
        <style>
          <class name="artist-art-thumb"/>
        </style>
      </object>
    </child>

    <!-- left slot: name + subtitle -->
    <child type="left">
      <object class="GtkBox" id="col_left">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkLabel" id="title">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="library-row-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="subtitle">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="library-row-subtitle"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <!-- right slot: album art strip -->
    <child type="right">
      <object class="GtkBox" id="art_strip">
        <property name="orientation">horizontal</property>
        <property name="spacing">4</property>
        <property name="valign">center</property>
        <property name="halign">end</property>
        <style>
          <class name="album-art-strip"/>
        </style>
      </object>
    </child>
  </object>
</interface>
