<interface>
  <!--
    Credit row for track metadata popover.

    Layout: ProportionalBox splits the row proportionally:
      left  slot (40%): artist button, left-aligned, natural width
      right slot (60%): role/instrument label
  -->
  <object class="ProportionalBox" id="credit_row">
    <style><class name="track-info-row"/></style>

    <!-- Artist button: occupies the 40% left slot, left-aligned, no expand -->
    <child type="left">
      <object class="GtkBox" id="credit_artist_cell">
        <property name="orientation">horizontal</property>
        <child>
          <object class="GtkButton" id="credit_artist_btn">
            <property name="has-frame">false</property>
            <property name="hexpand">false</property>
            <property name="halign">start</property>
            <style><class name="artist-btn"/></style>
            <child>
              <object class="GtkLabel" id="credit_artist_label">
                <property name="ellipsize">end</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Role label: occupies the remaining 60% right slot -->
    <child type="right">
      <object class="GtkLabel" id="credit_role_label">
        <property name="xalign">0</property>
        <property name="overflow">visible</property>
        <style><class name="track-info-label"/></style>
      </object>
    </child>

  </object>
</interface>
