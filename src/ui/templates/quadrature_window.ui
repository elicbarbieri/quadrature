<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="UiWindow" parent="GtkApplicationWindow">
    <property name="title">Quadrature</property>
    <property name="default-width">1280</property>
    <property name="default-height">600</property>

    <!-- Root overlay for toast notifications -->
    <child>
      <object class="GtkOverlay" id="root_overlay">

        <!-- Main horizontal layout -->
        <child>
          <object class="GtkBox" id="main_box">
            <property name="orientation">horizontal</property>

            <!-- Nav bar placeholder (custom widget created programmatically) -->

            <!-- Content stack overlay (for errors panel and toasts) -->
            <child>
              <object class="GtkOverlay" id="content_overlay">
                <property name="hexpand">true</property>

                <!-- Content stack -->
                <child>
                  <object class="GtkStack" id="content_stack">
                    <property name="transition-type">crossfade</property>
                    <style>
                      <class name="library-content"/>
                    </style>
                    <!-- Views added programmatically -->
                  </object>
                </child>

                <!-- Toast notification (centered over content area, hidden initially) -->
                <child type="overlay">
                  <object class="GtkBox" id="toast_overlay">
                    <property name="orientation">horizontal</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="margin-top">20</property>
                    <property name="visible">false</property>
                    <style>
                      <class name="toast-notification"/>
                    </style>
                    <child>
                      <object class="GtkLabel" id="toast_label">
                        <property name="justify">center</property>
                        <style>
                          <class name="toast-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

            <!-- Separator -->
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
              </object>
            </child>

            <!-- Channels panel - fixed width, does not expand -->
            <child>
              <object class="GtkBox" id="channels_panel">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <style>
                  <class name="channels-panel"/>
                </style>

                <!-- Channel strips container - margins inside fixed width -->
                <child>
                  <object class="GtkBox" id="channel_strips_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <property name="vexpand">true</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <!-- Channel strips added programmatically -->
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>
