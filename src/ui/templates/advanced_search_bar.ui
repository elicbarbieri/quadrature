<?xml version="1.0" encoding="UTF-8"?>
<!--
  Advanced Search Bar Template

  Shared credit search + role filter panel, revealed by the
  Advanced toggle in filter_sort_bar.ui.
-->
<interface>
  <object class="GtkRevealer" id="advanced_revealer">
    <property name="reveal-child">false</property>
    <property name="transition-type">slide-down</property>
    <property name="transition-duration">200</property>
    <child>
      <object class="GtkBox" id="advanced_panel">
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <property name="margin-end">16</property>
        <style>
          <class name="filter-bar"/>
        </style>

        <!-- Credit search -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">0</property>
            <style>
              <class name="filter-field"/>
            </style>
            <child>
              <object class="GtkLabel">
                <property name="label">Credit</property>
              </object>
            </child>
            <child>
              <object class="GtkSearchEntry" id="credit_search_entry">
                <property name="placeholder-text">Search credits...</property>
                <property name="width-chars">20</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Role filter -->
        <child>
          <object class="GtkDropDown" id="filter_role">
            <style>
              <class name="filter-field"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
