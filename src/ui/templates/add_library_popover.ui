<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkPopover" id="add_library_popover">
    <property name="autohide">false</property>
    <property name="has-arrow">false</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">16</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>

        <!-- Title -->
        <child>
          <object class="GtkLabel">
            <property name="label">Add Library</property>
            <property name="xalign">0</property>
            <style>
              <class name="library-title"/>
            </style>
          </object>
        </child>

        <!-- Mode toggles -->
        <child>
          <object class="GtkBox" id="mode_toggles">
            <property name="orientation">horizontal</property>
            <property name="halign">center</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkToggleButton" id="mode_local_btn">
                <property name="label">Local Folder</property>
                <property name="active">true</property>
                <style>
                  <class name="toggle-btn"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="mode_portable_btn">
                <property name="label">Portable Drive</property>
                <style>
                  <class name="toggle-btn"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- Music folder row -->
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Music Folder</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkLabel" id="music_path_label">
                    <property name="label">No folder selected</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                    <property name="ellipsize">middle</property>
                    <property name="width-chars">30</property>
                    <property name="opacity">0.5</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="music_browse_btn">
                    <property name="label">Browse...</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Data directory row (hidden by default, revealed in portable mode) -->
        <child>
          <object class="GtkRevealer" id="data_section_revealer">
            <property name="reveal-child">false</property>
            <property name="transition-type">slide-down</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Index Location</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="data_path_label">
                        <property name="label">Select a music folder first</property>
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <property name="ellipsize">middle</property>
                        <property name="width-chars">30</property>
                        <property name="opacity">0.5</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="data_browse_btn">
                        <property name="label">Browse...</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Stored locally so it persists when the drive is disconnected.</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="opacity">0.4</property>
                    <style>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Action buttons -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="add_cancel_btn">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="add_confirm_btn">
                <property name="label">Add</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
