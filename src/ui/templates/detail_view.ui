<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quadrature Unified Detail View Template

  Three-state view: empty, album detail, artist detail.
  Uses GtkStack for state management. C code binds data and handles navigation.
-->
<interface>
  <object class="GtkBox" id="detail_view">
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>

    <!-- Back Header - Hidden in empty state -->
    <child>
      <object class="GtkBox" id="back_header">
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">8</property>
        <child>
          <object class="GtkButton" id="back_button">
            <property name="halign">start</property>
            <style>
              <class name="flat"/>
              <class name="detail-back"/>
            </style>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">go-previous-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="back_label">
                    <property name="label">Back</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Content Stack - Three states -->
    <child>
      <object class="GtkStack" id="content_stack">
        <property name="vexpand">true</property>
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">150</property>

        <!-- ═══════════════════════════════════════════════════════════════
             EMPTY STATE
             ═══════════════════════════════════════════════════════════════ -->
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="GtkBox" id="empty_state">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="vexpand">true</property>
                <style>
                  <class name="empty-state"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">media-optical-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="opacity">0.3</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">No Selection</property>
                    <style>
                      <class name="empty-state-title"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Select an artist or album to view details here</property>
                    <style>
                      <class name="empty-state-subtitle"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- ═══════════════════════════════════════════════════════════════
             ALBUM DETAIL STATE
             ═══════════════════════════════════════════════════════════════ -->
        <child>
          <object class="GtkStackPage">
            <property name="name">album</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="album_content">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-bottom">24</property>

                    <!-- Album Header -->
                    <child>
                      <object class="GtkBox" id="album_header">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">20</property>
                        <child>
                          <object class="GtkImage" id="album_art">
                            <property name="icon-name">media-optical-symbolic</property>
                            <property name="pixel-size">250</property>
                            <style>
                              <class name="detail-album-art"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkLabel" id="album_title">
                                <property name="label">Album Title</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="wrap-mode">word-char</property>
                                <property name="max-width-chars">40</property>
                                <style>
                                  <class name="detail-title"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkButton" id="album_artist_link">
                                    <property name="label">Artist Name</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="artist-link"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="album_year">
                                    <property name="label">2024</property>
                                    <style>
                                      <class name="detail-meta"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="album_stats">
                                <property name="label">12 tracks - 45:32</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="detail-meta"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="album_featuring_box">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">4</property>
                                <property name="margin-top">8</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Featuring:</property>
                                    <style>
                                      <class name="detail-featuring-label"/>
                                    </style>
                                  </object>
                                </child>
                                <!-- Artist links populated dynamically -->
                                <child>
                                  <object class="GtkFlowBox" id="album_featuring_artists">
                                    <property name="homogeneous">false</property>
                                    <property name="selection-mode">none</property>
                                    <property name="max-children-per-line">10</property>
                                    <property name="row-spacing">2</property>
                                    <property name="column-spacing">4</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Tracks Container - populated with track rows -->
                    <child>
                      <object class="GtkBox" id="album_tracks_container">
                        <property name="orientation">vertical</property>
                        <property name="spacing">0</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- ═══════════════════════════════════════════════════════════════
             ARTIST DETAIL STATE
             ═══════════════════════════════════════════════════════════════ -->
        <child>
          <object class="GtkStackPage">
            <property name="name">artist</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="artist_content">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-bottom">24</property>

                    <!-- Artist Header -->
                    <child>
                      <object class="GtkBox" id="artist_header">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkLabel" id="artist_name">
                            <property name="label">Artist Name</property>
                            <property name="xalign">0</property>
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word-char</property>
                            <style>
                              <class name="detail-title"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="artist_stats">
                            <property name="label">4 albums - 89 tracks - 5h 23m</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="detail-meta"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- ALBUMS Section Label -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">ALBUMS</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">8</property>
                        <style>
                          <class name="detail-section-header"/>
                        </style>
                      </object>
                    </child>

                    <!-- Album Cards Container - populated with album_card instances -->
                    <child>
                      <object class="GtkBox" id="artist_albums_container">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>
                      </object>
                    </child>

                    <!-- APPEARS ON Section -->
                    <child>
                      <object class="GtkBox" id="appears_on_section">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">16</property>

                        <!-- Section Header with Toggle -->
                        <child>
                          <object class="GtkBox" id="appears_on_header">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">APPEARS ON</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="detail-section-header"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="appears_on_toggle">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">0</property>
                                <style>
                                  <class name="linked"/>
                                </style>
                                <child>
                                  <object class="GtkToggleButton" id="toggle_albums_btn">
                                    <property name="label">Albums</property>
                                    <property name="active">true</property>
                                    <style>
                                      <class name="toggle-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkToggleButton" id="toggle_tracks_btn">
                                    <property name="label">Tracks</property>
                                    <style>
                                      <class name="toggle-btn"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Appears On Content Stack -->
                        <child>
                          <object class="GtkStack" id="appears_on_stack">
                            <property name="transition-type">crossfade</property>
                            <property name="transition-duration">100</property>

                            <!-- Albums View -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">albums</property>
                                <property name="child">
                                  <object class="GtkBox" id="appears_on_albums">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">16</property>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <!-- Tracks View -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">tracks</property>
                                <property name="child">
                                  <object class="GtkBox" id="appears_on_tracks">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">0</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
