<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library Album Row Template

  ProportionalBox layout: [art (natural)] [left (60%)] [right (40%)] [meta (natural)]

  art:   Album thumbnail
  left:  Title + primary artists + [lib-badge]
  right: Genre pills + [credit annotation]
  meta:  Year + track count (right-aligned)
-->
<interface>
  <object class="ProportionalBox" id="row">
    <property name="spacing">12</property>
    <property name="left-ratio">0.6</property>
    <property name="hexpand">true</property>
    <style>
      <class name="library-album-row"/>
    </style>

    <!-- art slot: album thumbnail -->
    <child type="art">
      <object class="GtkImage" id="art">
        <property name="icon-name">media-optical-symbolic</property>
        <property name="valign">center</property>
        <style>
          <class name="library-album-art"/>
        </style>
      </object>
    </child>

    <!-- left slot: title + artists + credit + library badges -->
    <child type="left">
      <object class="GtkBox" id="col_left">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkLabel" id="title">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="library-row-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="primary_artists_box">
            <property name="hexpand">true</property>
            <style>
              <class name="library-row-subtitle"/>
            </style>
          </object>
        </child>
        <!-- library badges: populated dynamically by row_helpers.c -->
        <child>
          <object class="QuadratureOverflowBox" id="library_badges">
            <property name="spacing">4</property>
            <property name="visible">false</property>
          </object>
        </child>
      </object>
    </child>

    <!-- right slot: genres + credit annotation -->
    <child type="right">
      <object class="GtkBox" id="col_right">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="overflow">hidden</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkBox" id="genres_box">
            <property name="spacing">4</property>
            <property name="halign">start</property>
          </object>
        </child>
        <!-- credit annotation: hidden unless credit data is set dynamically.
             credit_artist_btn is appended first (as pinned[0]) by C,
             then role pills as items, then "…" overflow indicator last. -->
        <child>
          <object class="QuadratureOverflowBox" id="credit_annotation">
            <property name="spacing">6</property>
            <property name="visible">false</property>
          </object>
        </child>
      </object>
    </child>

    <!-- meta slot: year + track count -->
    <child type="meta">
      <object class="GtkBox" id="meta_box">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkLabel" id="year">
            <property name="width-chars">4</property>
            <property name="xalign">1</property>
            <style>
              <class name="library-row-year"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="count">
            <property name="xalign">1</property>
            <property name="halign">end</property>
            <style>
              <class name="library-row-duration"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
