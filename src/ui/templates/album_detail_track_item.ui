<?xml version="1.0" encoding="UTF-8"?>
<!-- Album detail track item - uses GtkGrid for precise column alignment -->
<interface>
  <object class="GtkGrid" id="row">
    <property name="column-spacing">12</property>
    <property name="row-spacing">0</property>
    <property name="vexpand">false</property>
    <property name="valign">center</property>
    <style>
      <class name="album-detail-track"/>
    </style>

    <!-- Column 0: Track number (fixed width, left-aligned) -->
    <child>
      <object class="GtkLabel" id="track_num">
        <property name="valign">center</property>
        <property name="yalign">0.5</property>
        <property name="width-chars">3</property>
        <property name="xalign">0</property>
        <property name="hexpand">false</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
        <style>
          <class name="album-detail-track-num"/>
        </style>
      </object>
    </child>

    <!-- Column 1: Title (expanding, takes remaining space) -->
    <child>
      <object class="GtkLabel" id="title">
        <property name="xalign">0</property>
        <property name="yalign">0.5</property>
        <property name="ellipsize">end</property>
        <property name="valign">center</property>
        <property name="hexpand">true</property>
        <property name="halign">fill</property>
        <layout>
          <property name="column">1</property>
          <property name="row">0</property>
        </layout>
        <style>
          <class name="album-detail-track-title"/>
        </style>
      </object>
    </child>

    <!-- Column 2: Featuring artists only (no primary artists in album detail) -->
    <child>
      <object class="GtkBox" id="secondary_artists_box">
        <property name="orientation">horizontal</property>
        <property name="valign">center</property>
        <property name="hexpand">false</property>
        <property name="halign">start</property>
        <layout>
          <property name="column">2</property>
          <property name="row">0</property>
        </layout>
        <style>
          <class name="album-detail-track-featuring"/>
        </style>
      </object>
    </child>

    <!-- Column 3: Info button (fixed width) -->
    <child>
      <object class="GtkButton" id="info_btn">
        <property name="valign">center</property>
        <property name="tooltip-text">Show track metadata</property>
        <property name="has-frame">false</property>
        <property name="hexpand">false</property>
        <layout>
          <property name="column">3</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="GtkImage">
            <property name="icon-name">help-about-symbolic</property>
            <property name="pixel-size">14</property>
          </object>
        </child>
        <style>
          <class name="flat"/>
          <class name="album-detail-track-info-btn"/>
        </style>
      </object>
    </child>

    <!-- Column 4: Duration (fixed width, left-aligned) -->
    <child>
      <object class="GtkLabel" id="duration">
        <property name="valign">center</property>
        <property name="yalign">0.5</property>
        <property name="width-chars">5</property>
        <property name="xalign">0</property>
        <property name="hexpand">false</property>
        <layout>
          <property name="column">4</property>
          <property name="row">0</property>
        </layout>
        <style>
          <class name="album-detail-track-duration"/>
        </style>
      </object>
    </child>
  </object>
</interface>
