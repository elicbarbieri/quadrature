<?xml version="1.0" encoding="UTF-8"?>
<!--
  Album detail track item — ProportionalBox layout:
  [track_num (natural)] [title (60%)] [artists (40%)] [duration + info (natural)]
-->
<interface>
  <object class="ProportionalBox" id="row">
    <property name="spacing">6</property>
    <property name="left-ratio">0.6</property>
    <property name="hexpand">true</property>
    <style>
      <class name="album-detail-track"/>
    </style>

    <!-- art slot: track number (natural width) -->
    <child type="art">
      <object class="GtkLabel" id="track_num">
        <property name="valign">center</property>
        <property name="width-chars">3</property>
        <property name="xalign">0</property>
        <style>
          <class name="album-detail-track-num"/>
        </style>
      </object>
    </child>

    <!-- left slot: title (60% of flexible space) -->
    <child type="left">
      <object class="GtkLabel" id="title">
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <property name="valign">center</property>
        <style>
          <class name="album-detail-track-title"/>
        </style>
      </object>
    </child>

    <!-- right slot: combined artists (40% of flexible space) -->
    <child type="right">
      <object class="QuadratureOverflowBox" id="artists_box">
        <property name="valign">center</property>
        <property name="halign">end</property>
      </object>
    </child>

    <!-- meta slot: duration + info button (natural width) -->
    <child type="meta">
      <object class="GtkBox" id="col_meta">
        <property name="spacing">6</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkLabel" id="duration">
            <property name="valign">center</property>
            <property name="width-chars">5</property>
            <property name="xalign">0</property>
            <style>
              <class name="album-detail-track-duration"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="info_btn">
            <property name="valign">center</property>
            <property name="tooltip-text">Show track metadata</property>
            <property name="has-frame">false</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">help-about-symbolic</property>
                <property name="pixel-size">16</property>
              </object>
            </child>
            <style>
              <class name="flat"/>
              <class name="album-detail-track-info-btn"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
