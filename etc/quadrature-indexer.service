[Unit]
Description=Quadrature Music Library Indexer
Documentation=https://github.com/quadrature/quadrature
After=network.target

[Service]
Type=simple
User=quadrature
Group=quadrature
ExecStart=/usr/bin/quadrature-indexer --foreground --config /etc/quadrature/indexer.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=on-failure
RestartSec=5

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Allow read access to music directories and write to database
ReadWritePaths=/var/lib/quadrature
ReadOnlyPaths=/mnt/music

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quadrature-indexer

[Install]
WantedBy=multi-user.target
