# Quadrature Indexer Configuration
# Copy to /etc/quadrature/indexer.conf and modify as needed
#
# Note: The indexer requires CAP_SYS_ADMIN capability or root privileges
# for fanotify filesystem watching.

[daemon]
# PID file location (used when running as daemon)
pid_file = /var/run/quadrature-indexer.pid

# Log file location (empty for stderr)
log_file = /var/log/quadrature/indexer.log

# Log level: error, warn, info, debug
log_level = info

[database]
# SQLite database path
path = /var/lib/quadrature/library.db

# WAL checkpoint interval in seconds (0 to disable)
checkpoint_interval = 300

[scanner]
# Directories to watch (semicolon-separated)
# Example: /mnt/music;/mnt/archive;/home/user/Music
watch_paths = /mnt/music

# Number of scanner threads (0 = auto, based on CPU count)
thread_count = 0

# Batch size for database commits
batch_size = 500

# Full reconciliation interval in hours (0 to disable)
# Reconciliation compares all file_state entries with filesystem
reconcile_interval = 24

[watcher]
# Debounce interval in milliseconds
# Coalesces rapid file changes to reduce database writes
debounce_ms = 500

[replication]
# Enable HTTP replication server for slave nodes
enabled = false

# Address to bind replication server
bind_address = 0.0.0.0

# Port for replication server
port = 7432
