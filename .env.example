# Copy to .env and fill in values (never commit .env)
#
# Required for MusicBrainz/AcoustID integration tests (test_mb_resolve).
# Tests skip gracefully if MB_PG_PASSWORD / ACOUSTID_PG_PASSWORD are absent.

MB_HOST=192.168.1.220
MB_DBNAME=musicbrainz_db
MB_USER=musicbrainz
MB_PG_PASSWORD=

ACOUSTID_DBNAME=acoustid
ACOUSTID_USER=acoustid
ACOUSTID_PG_PASSWORD=

ACOUSTID_INDEX_URL=http://192.168.1.220:8081
